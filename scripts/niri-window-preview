#!/bin/bash
# Preview script for niri window picker
# Usage: preview.sh id title app_id pid is_focused is_floating

id="$1"
title="$2"
app_id="$3"
pid="$4"
focused="$5"
floating="$6"

echo "Window #$id"
echo "=================="
echo "Title: $title"
echo "App: $app_id"
echo "PID: $pid"
echo ""
echo "Status: $(if [ "$focused" = "true" ]; then echo "Focused"; else echo "Unfocused"; fi) | $(if [ "$floating" = "true" ]; then echo "Floating"; else echo "Tiling"; fi)"
echo ""
echo "ID: $id"