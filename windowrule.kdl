// Window Rules
window-rule {
    match app-id="floating"
    open-floating true
}
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}
// window-rule {
//     match hotkey-overlay-title="Floating"
//
//     open-floating true
// }
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
    default-column-width { proportion 0.25; }
    default-window-height { proportion 0.25; }
    default-floating-position x=0 y=0 relative-to="top-right"
}
window-rule {
    match app-id="chromium" title="^Picture-in-Picture$"
    open-floating true
    default-column-width { proportion 0.25; }
    default-window-height { proportion 0.25; }
    default-floating-position x=0 y=0 relative-to="top-right"
}

window-rule {
    match app-id="org.mozilla.Thunderbird" title=""
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.4; }
}

window-rule {
    match app-id=r#"com.github.hluk.copyq"#
    open-floating true
}
window-rule {
    match app-id="clipse"
    open-floating true
    default-column-width { proportion 0.8; }
    default-window-height { proportion 0.8; }
}

window-rule {
    match app-id="ringboard-egui"
    open-floating true
    default-column-width { proportion 0.8; }
    default-window-height { proportion 0.8; }
}

window-rule {
    match app-id="ringboard-tui"
    open-floating true
    default-column-width { proportion 0.8; }
    default-window-height { proportion 0.8; }
}

window-rule {
    match app-id="fzpicker"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.4; }
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}
window-rule {
    match app-id="glide-glide"
    default-column-width { proportion 0.5; }
    default-window-height { proportion 1.0; }
    open-fullscreen false
}
window-rule {
    match app-id="glide-glide" title="^Picture-in-Picture$"
    open-floating true
    default-column-width { proportion 0.25; }
    default-window-height { proportion 0.25; }
    default-floating-position x=0 y=0 relative-to="top-right"
}

window-rule {
  match app-id=r"org.kde.kdeconnect.daemon" // ID of presentation pointer overlay
  open-floating true
  open-fullscreen false
  default-floating-position x=0 y=0 relative-to="top-left"

  // Adjust these to your monitor's resolution
  min-width 1920
  min-height 1080

  // Optionally customize opacity of pointer
  // opacity 1.0

  tiled-state true

  focus-ring {
    off
  }
  border {
    off
  }
  shadow {
    off
  }
  draw-border-with-background false
}


